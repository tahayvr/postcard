#!/usr/bin/env bash
# postcard-capture [region|windows|fullscreen|smart] [keep...]
# Take a screenshot and print the path of the file omarchy wrote.
# Prints nothing if the user cancelled.
# The shot is only raw material for the editor, so it goes to the scratch
# directory, not the user's screenshot folder; the export is what lands there.
set -uo pipefail

# slurp reads boxes from stdin whenever stdin is not a terminal, and the shell
# hands us an open pipe that never ends, so it would wait forever and never
# show its picker. Detach stdin before anything downstream can inherit it.
exec </dev/null

mode="${1:-region}"
shift 2>/dev/null
# Captures still on the card, when this one is going beside them.
keep=("$@")
case "$mode" in
  region|windows|fullscreen|smart) ;;
  *) mode="region" ;;
esac

# Older omarchy prints the saved path; Omasnap saves silently. Give each
# request its own directory so a cancelled capture cannot pick up an old shot.
dir="${XDG_RUNTIME_DIR:-/tmp}/postcard-captures"
mkdir -p "$dir" || exit 1
scratch="$(mktemp -d "$dir/.capture-XXXXXXXX")" || exit 1
trap 'rmdir "$scratch" 2>/dev/null || true' EXIT
path="$(OMARCHY_SCREENSHOT_DIR="$scratch" OMASNAP_SCREENSHOT_DIR="$scratch" omarchy capture screenshot "$mode" save 2>/dev/null | grep '^/' | tail -n1)"
if [ -z "$path" ] || [ ! -f "$path" ]; then
  path=""
  for f in "$scratch"/*.png; do
    [ -f "$f" ] || continue
    path="$f"
    break
  done
fi
[ -n "$path" ] && [ -f "$path" ] || exit 0

# Keep sources in the usual flat scratch directory for existing cleanup and
# multi-shot retention. A unique prefix also avoids same-second collisions.
if [[ "$path" == "$scratch/"* ]]; then
  capture_id="${scratch##*/}"
  destination="$dir/${capture_id#.}-${path##*/}"
  mv -- "$path" "$destination" || exit 1
  path="$destination"
fi

# Earlier captures go once a new one has replaced them, but not those still
# on the card beside it: a crop or a new layout reads its source again.
for f in "$dir"/*.png; do
  [ "$f" = "$path" ] && continue
  for k in "${keep[@]}"; do [ "$f" = "$k" ] && continue 2; done
  rm -f "$f"
done
printf '%s\n' "$path"
exit 0
